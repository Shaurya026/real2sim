# Copy to .env, edit, then explicitly load: set -a; . ./.env; set +a
# No script automatically loads this file. .env is ignored by Git.
# Use absolute executable paths when tools live in separate environments.
FFMPEG_BIN=ffmpeg
NS_PROCESS_BIN=ns-process-data
NS_TRAIN_BIN=ns-train
NS_EXPORT_BIN=ns-export
BLENDER_BIN=blender
SAM3D_PYTHON=/path/to/sam3d-objects/bin/python
SAM3D_REPO=/path/to/sam-3d-objects
SAM3D_CONFIG=/path/to/sam-3d-objects/checkpoints/hf/pipeline.yaml
# Shell helper used in the guide to run the separate review environment.
REVIEW_PYTHON=/path/to/room2sim-review/bin/python
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-6-astra
# Optional existing browser tools; omit/unset empty values.
# PLAYWRIGHT_MODULE=/absolute/path/to/playwright
# BROWSER_BIN=/absolute/path/to/chrome
